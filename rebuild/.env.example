# Default: OpenCode Zen free — no personal API key.
#   bun run chat
#
# scripts use ../scripts/bun.sh → prefers $HOME/.bun/bin/bun (1.4.x)
#
# Optional model / endpoint:
# REBUILD_LLM_MODEL=flint-40b-free
# OPENCODE_ZEN_URL=https://opencode.ai/inference/openai/v1
# OPENCODE_VERSION=2.2.0
#
# Optional OpenAI-compatible (paid / other gateway):
# REBUILD_LLM_PROVIDER=openai
# REBUILD_LLM_API_KEY=sk-...
# REBUILD_LLM_BASE_URL=https://api.openai.com/v1
# REBUILD_LLM_MODEL=gpt-4o-mini
