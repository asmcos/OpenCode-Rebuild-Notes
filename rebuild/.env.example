# Default provider: local OpenAI-compatible gateway (zen-free-agent on :8787)
#   # terminal 1 — start gateway (from your opencode checkout)
#   ~/.bun/bin/bun zen-free-agent/index.mjs --api-only
#   # terminal 2
#   bun run models
#   bun run chat
#
# REBUILD_LLM_PROVIDER=local
# REBUILD_LLM_BASE_URL=http://127.0.0.1:8787/v1
# REBUILD_LLM_MODEL=beam-free
# API_KEY=                 # only if gateway set API_KEY
#
# Switch Zen free ↔ Go and list only free models (saved in .rebuild-llm.json):
#   bun run models zen
#   bun run models go
#   bun run models use 2
#   bun run models use zen big-pickle
#
# Optional Zen (often rate-limited):
# REBUILD_LLM_PROVIDER=zen
# OPENCODE_ZEN_URL=https://opencode.ai/inference/openai/v1
#
# Optional Go (free models, needs a key — do not commit it):
# REBUILD_LLM_PROVIDER=go
# OPENCODE_API_KEY=oc_sk_...
# OPENCODE_GO_URL=https://opencode.ai/inference/go/openai/v1
#
# Optional paid OpenAI-compatible:
# REBUILD_LLM_PROVIDER=openai
# REBUILD_LLM_API_KEY=sk-...
# REBUILD_LLM_BASE_URL=https://api.openai.com/v1
#
# Permissions (OpenCode-style assert; teaching default = external ask):
# REBUILD_ALLOW_EXTERNAL=1              # same as chat --allow-external (schema-like)
# REBUILD_ASK_EXTERNAL=1                # force external ask
# REBUILD_EXTERNAL_DIRECTORY=ask|allow
# REBUILD_PERMISSION_UNATTENDED=allow   # non-TTY ask → allow (default deny)
